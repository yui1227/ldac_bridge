+// A previous run that stopped before reading its last reply (e.g. Read Version) leaves that
+// Command Complete queued in the controller. Without this check it is taken as the reply to
+// HCI Reset, every later reply is off by one, and the next run inherits the same problem.
+static bool is_stale_reply(uint8_t * packet, uint16_t size, uint16_t expected_opcode){
+    if (packet == NULL || packet[0] != 0x0e || size < 5) return false;
+    return little_endian_read_16(packet, 3) != expected_opcode;
+}
